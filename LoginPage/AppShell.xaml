<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LoginPage.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LoginPage"
    Title="LoginPage"
    FlyoutBehavior="Disabled">
    <!-- Each ShellContent represents a page in the application along with names to route to them -->
    
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate local:RegisterPage}"
        Route="RegisterPage" />

    <ShellContent
        Title="Manager Dashboard"
        ContentTemplate="{DataTemplate local:ManagerDashboardPage}"
        Route="ManagerDashboardPage" />

    <ShellContent
        Title="Waiter Dashboard"
        ContentTemplate="{DataTemplate local:WaiterDashboardPage}"
        Route="WaiterDashboardPage" />


    <ShellContent
        Title="Table Layout"
        ContentTemplate="{DataTemplate local:TableLayoutPage}"
        Route="TableLayoutPage" />

    <ShellContent
    Title="Order Queue"
    ContentTemplate="{DataTemplate local:OrderQueuePage}"
    Route="OrderQueuePage" />

    <ShellContent
        Title="Inventory"
        ContentTemplate="{DataTemplate local:InventoryPage}"
        Route="InventoryPage" />
    
     <ShellContent
        Title="Sales"
        ContentTemplate="{DataTemplate local:SalesPage}"
        Route="SalesPage" />
    
     <ShellContent
        Title="Employee Profiles"
        ContentTemplate="{DataTemplate local:EmployeeProfilesPage}"
        Route="EmployeeProfilesPage" />
    
    <ShellContent
        Title="Refunds"
        ContentTemplate="{DataTemplate local:RefundsPage}"
        Route="RefundsPage" />

    <ShellContent
        Title="All Employees"
        ContentTemplate="{DataTemplate local:AllEmployeesPage}"
        Route="AllEmployeesPage" />

    <ShellContent
        Title="Add Order"
        ContentTemplate="{DataTemplate local:AddOrderMenuPage}"
        Route="AddOrderMenuPage" />

    <ShellContent
        Title="Checkout Card Payment"
        ContentTemplate="{DataTemplate local:CheckoutCardPaymentContactInfoPage}"
        Route="CheckoutCardPaymentContactInfoPage" />

    <ShellContent
        Title="Checkout Payment Method"
        ContentTemplate="{DataTemplate local:CheckoutPaymentMethodPage}"
        Route="CheckoutPaymentMethodPage" />

    <ShellContent
        Title="Checkout Card Review"
        ContentTemplate="{DataTemplate local:CheckoutCardReviewPage}"
        Route="CheckoutCardReviewPage" />

    <ShellContent
        Title="Checkout Cash Payment"
        ContentTemplate="{DataTemplate local:CheckoutCashPaymentContactInfoPage}"
        Route="CheckoutCashPaymentContactInfoPage" />

</Shell>
