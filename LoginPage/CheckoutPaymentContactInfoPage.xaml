<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoginPage.CheckoutPaymentContactInfoPage"
             Title="CheckoutPaymentContactInfoPage">
    
    <VerticalStackLayout>

        <Label
            Text ="Table Name"
            FontSize ="Large"/>

        <Border 
            Margin ="0,40,0,0" Padding ="40,0,40,10"
            BackgroundColor ="DimGray"
            StrokeShape ="RoundRectangle, 20"
            WidthRequest ="1800" HeightRequest ="800">

            <Grid RowDefinitions ="500,*,*" ColumnDefinitions ="1100,*,600">
                <Grid RowDefinitions ="60,30,60,30,60,30,60" ColumnDefinitions ="225,*,*"
                    Grid.Row ="0" Grid.Column ="0"
                    BackgroundColor ="Transparent"
                    WidthRequest ="1100" HeightRequest ="500">

                    <Label
                        Grid.Row ="0" Grid.Column ="1" Grid.ColumnSpan ="3"
                        Text ="Enter Payment Information for Bill" TextColor ="White"
                        FontSize ="Large"/>

                    <Label Grid.Row ="1"
                        Text ="Card Number*"
                        FontSize ="Medium"/>
                    <Entry 
                        Grid.Row ="2" Grid.Column ="0" Grid.ColumnSpan ="2"
                        Margin ="0,0,160,0"
                        Placeholder ="Card Number" PlaceholderColor ="LightGray"
                        FontSize ="Medium"
                        HorizontalTextAlignment ="Center"
                        WidthRequest ="500" HeightRequest ="20"/>

                    <Label Grid.Row ="3"
                        Text ="Name On Card*"
                        FontSize ="Medium"/>
                    <Entry 
                        Grid.Row ="4" Grid.Column ="0" Grid.ColumnSpan ="2"
                        Margin ="0,0,160,30"
                        Placeholder ="Name On Card" PlaceholderColor ="LightGray"
                        FontSize ="Medium"
                        HorizontalTextAlignment ="Center"
                        WidthRequest ="500" HeightRequest ="20"/>

                    <Label/>
                    <Entry/>
                </Grid>

                <BoxView 
                    Grid.Column ="1"
                    BackgroundColor ="White"
                    WidthRequest ="1" HeightRequest ="670"/>

                <AbsoluteLayout 
                    Grid.Row ="3" Grid.Column ="2"
                    WidthRequest ="600" HeightRequest ="500">

                </AbsoluteLayout>

                <BoxView
                    Grid.Row ="1"
                    BackgroundColor ="White"
                    HeightRequest ="1"/>

                <Label/>

                <Button Grid.Row ="2"/>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentPage>