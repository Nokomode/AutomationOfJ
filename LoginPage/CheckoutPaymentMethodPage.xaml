<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoginPage.CheckoutPaymentMethodPage"
             Title="CheckoutPaymentMethodPage">
             
    <VerticalStackLayout>

        <Label
            Text ="Table Name"
            FontSize ="Large"/>

        <Border
            Margin ="30" Padding ="40"
            BackgroundColor ="DimGray"
            StrokeShape ="RoundRectangle, 20"
            WidthRequest ="1800" HeightRequest ="800">
            <VerticalStackLayout Spacing ="100">
                <Label
                    Text ="Select Payment Method for Bill"
                    FontSize ="Large"
                    HorizontalOptions ="Center"/>

                <RadioButton
                    Margin ="0,100,0,0"
                    Content ="Credit/Debit Card"
                    FontSize ="Medium"
                    HorizontalOptions ="Center"/>

                <RadioButton
                    Margin ="0,0,135.9,0"
                    Content ="Cash" 
                    FontSize ="Medium"
                    HorizontalOptions ="Center"/>

                <Button
                    Margin ="0,150,0,0"
                    Text ="Continue"
                    FontSize ="Medium"
                    HorizontalOptions ="Center"
                    WidthRequest ="500"
                    Clicked ="Button_Clicked"
                    />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>