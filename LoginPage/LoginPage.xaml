<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoginPage.LoginPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="15"
            WidthRequest="560"
            VerticalOptions="Center">
            
            <!-- Username -->
            <Label x:Name="UsernameLabel" Text="Username"/>
            <Entry x:Name="UsernameField"
                   WidthRequest="500"
                   HorizontalOptions="Center"/>
            <!-- Password -->
            <Label x:Name="PasswordLabel" Text="Password"/>
            <Entry x:Name="PasswordField" IsPassword="True" 
                   WidthRequest="500"
                    HorizontalOptions="Center"/>

            <!-- Login error message -->
            <Label x:Name="LoginErrorLabel"
               Text="Incorrect login information, please try again."
               TextColor="Red"
               FontSize="13"
               HorizontalOptions="Center"
               IsVisible="False"
               Margin="0,4,0,4"/>
            
            <!-- Login button -->
            <Button
                x:Name="SubmitButton"
                Text="Log in"
                Clicked="OnLoginClicked"
                HorizontalOptions="Fill"
                WidthRequest="300"/>

            <!-- Register button -->
            <Button
                x:Name="RegisterButton"
                Text="Register"
                Clicked="OnRegisterClicked"
                WidthRequest="300"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
