<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LoginPage.ManagerDashboardPage"
    xmlns:views="clr-namespace:LoginPage"
    Title="ManagerDashboard">

    
    <VerticalStackLayout>
        <ContentView x:Name="TopBarContainer"/>

        <!-- Welcome message to manager -->
        <Label 
            x:Name="WelcomeLabel"
            Text="Welcome"
            FontSize="25"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            Margin="50"/>
    </VerticalStackLayout>
</ContentPage>