<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoginPage.TablePopUpView">
    
    <!--- Remember to adjust Width and height after table layout buttons are built -->
    <Border
        VerticalOptions ="Fill" HorizontalOptions ="Fill"
        x:Name ="BorderPopUp" x:FieldModifier ="public"
        BackgroundColor ="DimGray"
        
        WidthRequest ="500" HeightRequest ="300"
        StrokeShape ="RoundRectangle, 20"
        IsVisible ="true">
        <Grid RowDefinitions ="10,0,60,60,60,60" ColumnDefinitions ="500">
            <Label
                Grid.Row ="2" Grid.Column ="0" 
                FontSize = "Large"
                Text ="Table_Name" HorizontalOptions ="Center"/>
            <!--
            <Button
                Grid.Row ="1" Grid.Column ="0"
                BackgroundColor ="Transparent"
                WidthRequest ="30" HeightRequest ="30"
                HorizontalOptions ="End" VerticalOptions ="Fill"
                ImageSource ="whitexbutton.jpg"
                Clicked ="Button_Clicked">
            </Button> -->

            <Border HorizontalOptions ="Center"
                Grid.Row ="3" Grid.Column ="0"
                WidthRequest ="400" HeightRequest ="50">
                <Button 
                    Text ="Add Order" Clicked ="Button_Clicked"/>
            </Border>

            <Border 
                Grid.Row ="4" Grid.Column ="0"
                WidthRequest ="400" HeightRequest ="50">
                <Button Text ="Cancel/View Orders" Clicked ="Button_Clicked"/>
            </Border> 

            <Border x:Name ="b" 
                Grid.Row ="5" Grid.Column ="0"
                WidthRequest ="400" HeightRequest ="50">
                <Button 
                    x:Name ="MyButton" Text ="Checkout" Clicked ="Button_Clicked"/>
            </Border>     
        </Grid>
    </Border>
</ContentView>
