<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoginPage.TablePopUpView">
    
    <!--- Remember to adjust Width and height after table layout buttons are built -->
    <Border
        VerticalOptions ="Fill" HorizontalOptions ="Fill"
        x:Name ="BorderPopUp" x:FieldModifier ="public"
        BackgroundColor ="DimGray"
        
        WidthRequest ="500" HeightRequest ="300"
        StrokeShape ="RoundRectangle, 20"
        IsVisible ="true">
        <Grid RowDefinitions ="10,0,60,60,60,60" ColumnDefinitions ="500">
            <Label
                Grid.Row ="2" Grid.Column ="0" 
                FontSize = "Large"
                Text ="Table_Name" HorizontalOptions ="Center"/>
            
            <!-- Action Selection Pop Up Views -->

            <!--
            <Button
                Grid.Row ="1" Grid.Column ="0"
                BackgroundColor ="Transparent"
                WidthRequest ="30" HeightRequest ="30"
                HorizontalOptions ="End" VerticalOptions ="Fill"
                ImageSource ="whitexbutton.jpg"
                Clicked ="Button_Clicked">
            </Button> -->

            <Border x:Name ="AddOrderButton"
                HorizontalOptions ="Center"
                Grid.Row ="3" Grid.Column ="0"
                WidthRequest ="400" HeightRequest ="50">
                <Button 
                    Text ="Add Order" Clicked ="AddOrderButton_Clicked"/>
            </Border>

            <Border x:Name ="Cancel_ViewButton"
                Grid.Row ="4" Grid.Column ="0"
                WidthRequest ="400" HeightRequest ="50">
                <Button Text ="Cancel/View Orders" Clicked ="Cancel_ViewButton_Clicked"/>
            </Border> 

            <Border x:Name ="CheckoutButton" 
                Grid.Row ="5" Grid.Column ="0"
                WidthRequest ="400" HeightRequest ="50">
                <Button 
                    Text ="Checkout" Clicked ="CheckoutButton_Clicked"/>
            </Border>

            <!-- Bill Spliting Pop Up Views -->
            
            <Label x:Name ="BillSplitingLabel" 
                Grid.Row ="3"
                Text ="How many bills will all orders be split between"
                MaxLines ="2"
                IsVisible ="false"/>

            <Picker x:Name ="BillNumberPicker"
                Grid.Row ="4"
                Title ="Select Number of Bills"
                IsVisible ="false"/>

            <Button x:Name ="BillNumberConfirmButton"
                Grid.Row ="5"
                Text="Confirm"
                IsVisible ="false"/>
        </Grid>
    </Border>
</ContentView>
