            <Border 
                BackgroundColor ="White" Padding ="3"
                Grid.Row ="0" Grid.Column ="2" Grid.ColumnSpan ="2"
                StrokeShape ="RoundRectangle, 30">

                <HorizontalStackLayout Spacing ="-1">
                    <Border 
                        BackgroundColor ="{StaticResource Gray900}"
                        StrokeShape="RoundRectangle, 25, 0, 25, 0"
                        WidthRequest="205">

                        <Button 
                            BackgroundColor ="Transparent"
                            ImageSource ="greencircle.png" 
                            Text ="Clean" TextColor ="White" FontSize ="23"/>
                    </Border>

                    <BoxView BackgroundColor ="White" WidthRequest ="4"/>

                    <Border 
                        BackgroundColor ="{StaticResource Gray900}"
                        StrokeShape="RoundRectangle, 0, 0, 0, 0"
                        WidthRequest="205">

                        <Button 
                            BackgroundColor ="Transparent"
                            ImageSource ="yellowcircle.png" 
                            Text ="Occupied" TextColor ="White" FontSize ="23"/>
                    </Border>

                    <BoxView BackgroundColor ="White" WidthRequest ="4"/>

                    <Border 
                        BackgroundColor ="{StaticResource Gray900}"
                        StrokeShape="RoundRectangle, 0, 25, 0, 25"
                        WidthRequest="206">

                        <Button 
                            BackgroundColor ="Transparent"
                            HorizontalOptions = "Center" VerticalOptions ="Center"
