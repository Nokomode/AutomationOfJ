            <Button
                x:Name ="PopUpButton"
                AbsoluteLayout.LayoutBounds ="450,0"
                BackgroundColor ="Transparent"
                WidthRequest ="30" HeightRequest ="30"
                HorizontalOptions ="End" VerticalOptions ="Center"
                ImageSource ="whitexbutton.jpg"
